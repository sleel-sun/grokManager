{
    "manifest_version": 3,
    "name": "Turnstile Patcher",
    "version": "2.1",
    "content_scripts": [
        {
            "js": [
                "./script.js"
            ],
            "matches": [
                "*://*.x.ai/*",
                "*://*.grok.com/*",
                "*://accounts.x.ai/*"
            ],
            "run_at": "document_start",
            "all_frames": true
        }
    ]
}
