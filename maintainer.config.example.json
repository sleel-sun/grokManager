{
    "run": {
        "count": 10
    },
    "email": {
        "provider": "worker",
        "worker_domain": "email.example.com",
        "email_domains": [
            "example.com"
        ],
        "admin_password": "your-worker-admin-password",
        "verify_ssl": true,
        "credentials_file": "mail_credentials.txt",
        "alias_mode": "plus",
        "alias_random_length": 8,
        "max_aliases_per_account": 5,
        "poll_interval": 3,
        "recent_seconds": 600,
        "imap_hosts": [
            "outlook.office365.com",
            "imap-mail.outlook.com"
        ],
        "imap_last_n": 20,
        "require_recipient_match": true
    },
    "api": {
        "endpoint": "http://127.0.0.1:8000/v1/admin/tokens",
        "token": "grok2api",
        "append": true,
        "pool": "basic",
        "verify_ssl": true
    },
    "grok_build": {
        "auto_oauth_after_register": true,
        "required": false,
        "delay_sec": 0,
        "poll_timeout_sec": 90,
        "proxy": ""
    },
    "web": {
        "registration_env_retry_limit": 2,
        "turnstile_manual_wait_sec": 0,
        "turnstile_solver_provider": "",
        "turnstile_solver_api_key": "",
        "turnstile_solver_timeout_sec": 150,
        "turnstile_solver_poll_sec": 5
    }
}
