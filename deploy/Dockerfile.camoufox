FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libasound2 \
        libcairo2 \
        libdbus-glib-1-2 \
        libgbm1 \
        libgtk-3-0 \
        libpango-1.0-0 \
        libx11-xcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libxt6 \
    && rm -rf /var/lib/apt/lists/*

ARG CAMOUFOX_VERSION=0.4.11
RUN pip install --no-cache-dir "camoufox==${CAMOUFOX_VERSION}" "aiohttp>=3.10" \
    && python -m camoufox fetch

COPY deploy/camoufox_service.py /app/camoufox_service.py

EXPOSE 8193
CMD ["python", "/app/camoufox_service.py"]
